# ---------------------------------------------------------------- 运行产物
# 学生数据（含数据库、编译临时文件）——绝不进版本库
data/
*.db
*.db-wal
*.db-shm

# ---------------------------------------------------------------- 体积/平台相关
# Windows 版 SDCC 工具链约 294MB：只有 Windows 本机用得上，
# Linux 容器里由 apt 安装，云端包由 toolchain/sdcc-linux 提供
toolchain/
# 云端发布用的瘦身副本，由 tools/make_cloud_bundle.mjs 重新生成
cloud/

# 隧道工具（55MB）
cloudflared.exe

# ---------------------------------------------------------------- 依赖/缓存
node_modules/
.playwright-cli/
*.log

# ---------------------------------------------------------------- 本地配置
.env
.env.*
certs/
.workbuddy/

# ---------------------------------------------------------------- 打包产物
*.tgz
*.tar.gz
release/
